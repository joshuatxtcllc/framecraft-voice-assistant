# Anthropic API key used to run Claude for each voice request.
ANTHROPIC_API_KEY=

# Claude model to use for assistant turns.
CLAUDE_MODEL=claude-sonnet-4-5

# Shared secret the iOS app must send as `x-assistant-key`.
# Generate a long random string — this endpoint can trigger real actions
# (send email, create orders, etc.) so treat it like a password.
ASSISTANT_API_KEY=

# --- FrameKraft MCP connection -------------------------------------------
# The FrameKraft MCP server is already deployed (see the framekraft repo).
# Point this at its public/Railway URL and give it whatever bearer token
# that server expects. If FrameKraft's MCP server is not exposed over
# HTTP/SSE yet, see server/README.md for the fallback approach.
FRAMEKRAFT_MCP_URL=
FRAMEKRAFT_MCP_TOKEN=

# Port Railway will inject automatically — safe to leave unset locally.
PORT=3000
