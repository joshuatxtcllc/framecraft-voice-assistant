# Backend deployed on Railway (same service the iOS app talks to).
BACKEND_URL=https://YOUR-APP.up.railway.app
ASSISTANT_API_KEY=YOUR_ASSISTANT_API_KEY

# Used for real speech-to-text (Whisper) and text-to-speech.
OPENAI_API_KEY=

# Which openWakeWord pretrained model to listen for. Ships with real,
# working models out of the box — "hey_jarvis" is a good default until
# you train a custom "framecraft"/"hey framecraft" model (see README).
WAKE_WORD_MODEL=hey_jarvis

# Detection confidence threshold (0-1). Lower = more sensitive/more
# false triggers. 0.5 is openWakeWord's own recommended starting point.
WAKE_WORD_THRESHOLD=0.5

# Input/output audio device index. Leave unset to use the system default;
# run `python -m sounddevice` to list device indices if you need a
# specific USB mic/speaker.
INPUT_DEVICE=
OUTPUT_DEVICE=
